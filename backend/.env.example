# =========================================================================
# KANBAN COLLABORATIVE CORE - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# The network port allocation where the Express web server instance will listen.
PORT=5001

# Secure MongoDB Atlas production cloud connection uri string token sequence.
# Replace with your actual user credentials and target cluster database name instance.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<database_name>?retryWrites=true&w=majority

# Cryptographic token signature hash key string used by JSON Web Token (JWT) algorithms.
# Input a high-entropy string block to secure cookies, sessions, and profile handshakes.
JWT_SECRET=your_super_secure_random_hex_string_secret_here